			"born_in_chaos_v1:siamese_skeletonsleft": true
			"naturalist:ray": true
			"born_in_chaos_v1:mother_spider": true
			"valarian_conquest:male_citizen": true
			"valarian_conquest:female_citizen": true
			"naturalist:blobfish": true
			"minecraft:rabbit": true
			"valarian_conquest:archer": true
			"naturalist:lizard": true
			"naturalist:butterfly": true
			"born_in_chaos_v1:restless_spirit": true
			"naturalist:firefly": true
			"naturalist:deer": true
			"naturalist:jellyfish": true
			"born_in_chaos_v1:supreme_bonescaller": true
			"minecraft:salmon": false
