			"valarian_conquest:soldier": true
			"naturalist:starfish": true
			"naturalist:piranha": true
			"illagerinvasion:archivist": true
			"illagerinvasion:basher": true
			"aquaculture:blackfish": false
			"naturalist:bird": true
			"aquaculture:perch": false
			"born_in_chaos_v1:bloody_gadfly": true
			"minecraft:wolf": true
			"born_in_chaos_v1:swarmer": true
			"mowziesmobs:ferrous_wroughtnaut": true
			"naturalist:bear": true
			"naturalist:tiger": true
			"aquaculture:atlantic_halibut": false
			"born_in_chaos_v1:door_knight": true
			"aquaculture:pacific_halibut": false
			"born_in_chaos_v1:siamese_skeletons": true
			"minecraft:drowned": true
			"minecraft:pillager": true
			"born_in_chaos_v1:maggot": true
			"aquaculture:pink_salmon": false
			"born_in_chaos_v1:spiritof_chaos": true
			"born_in_chaos_v1:decrepit_skeleton": true
			"naturalist:snake": true
